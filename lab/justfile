# ot-anom lab — mini OT network in containerlab: one PLC with a simulated
# process, one HMI/SCADA poller, rare operator writes, and pcap capture.
# The traffic this generates is the "normal" baseline for anomaly detection.

# list available recipes
default:
    @just --list

# (first run installs python3-pymodbus + tcpdump in the nodes, ~1 min)
# deploy the lab (PLC + process sim, HMI / operator console) and start the PLC
up:
    clab dep -t clab-ot-anom.clab.yml
    docker exec clab-ot-anom-modbus-server sh -c 'apt-get update -qq && apt-get install -y -qq python3-pymodbus tcpdump >/dev/null'
    docker exec clab-ot-anom-modbus-master sh -c 'apt-get update -qq && apt-get install -y -qq python3-pymodbus >/dev/null'
    docker exec -d clab-ot-anom-modbus-server sh -c 'python3 /opt/modbus/server.py >/tmp/modbus-server.log 2>&1'
    @echo "lab is up. try: just hello | just run | just sp | just capture"

# smoke test: FC6 setpoint write + FC4/FC3 read-back + server log
hello:
    docker exec clab-ot-anom-modbus-master python3 /opt/modbus/op.py modbus-server 240
    @echo "--- modbus-server saw: ---"
    docker exec clab-ot-anom-modbus-server sh -c 'grep -E "slave up|seeded|sim:|applied|served" /tmp/modbus-server.log'

# run the HMI/SCADA poller for secs, then tail the server log
run secs='30':
    docker exec clab-ot-anom-modbus-master python3 /opt/modbus/master.py modbus-server --duration {{secs}}
    @echo "--- modbus-server saw (last 15 requests): ---"
    docker exec clab-ot-anom-modbus-server sh -c 'tail -15 /tmp/modbus-server.log'

# operator action: FC6 write of hr[0] setpoint in tenths of °C
sp tenths='250':
    docker exec clab-ot-anom-modbus-master python3 /opt/modbus/op.py modbus-server {{tenths}}

# ---- offline data pipeline (host-side scripts, no lab needed) ----

# simulate `hours` of lab-like traffic into data/sim-<scenario>.jsonl
# scenarios: normal poll-storm write-flood off-schedule rogue-master exception-storm
simulate hours='1' scenario='normal':
    python3 simulate.py --hours {{hours}} --scenario {{scenario}} --out data/sim-{{scenario}}.jsonl
    @echo "-> data/sim-{{scenario}}.jsonl  (featurize: just featurize data/sim-{{scenario}}.jsonl)"

# featurize events.jsonl file(s) into windows.csv
featurize events out='data/windows.csv':
    python3 featurize.py --events {{events}} --out {{out}}
    @echo "-> {{out}}"

# featurize captured pcap(s) into windows.csv (glob ok, parsed on the host)
featurize-pcap pcap out='data/windows.csv':
    python3 featurize.py --pcap {{pcap}} --out {{out}}
    @echo "-> {{out}}"

# generate all 6 scenarios + per-scenario windows.csv + feature comparison table
sim-all hours='0.5':
    #!/bin/sh
    set -e
    mkdir -p data
    for s in normal poll-storm write-flood off-schedule rogue-master exception-storm; do
        python3 simulate.py --hours {{hours}} --scenario "$s" --out "data/sim-$s.jsonl"
        python3 featurize.py --events "data/sim-$s.jsonl" --out "data/sim-$s-windows.csv" 2>/dev/null
    done
    python3 - data/sim-*-windows.csv <<'EOF'
    import sys
    import pandas as pd
    frames = {p.split("sim-")[1].split("-windows")[0]: pd.read_csv(p) for p in sys.argv[1:]}
    cols = ["n_req", "n_write_fc", "n_except", "n_masters", "poll_gap_mean_s", "poll_gap_cv"]
    print("window means:")
    print(pd.DataFrame({k: f[cols].mean() for k, f in frames.items()}).round(3).to_string())
    EOF

# capture secs of port-502 traffic on the server node into lab/data/
capture secs='30':
    #!/bin/sh
    # server-endpoint capture sees all of the PLC's own traffic; a true
    # passive tap node is a later step.
    set -e
    ts=$(date +%Y%m%d-%H%M%S)
    docker exec -d clab-ot-anom-modbus-server tcpdump -i any -w /tmp/capture.pcap tcp port 502
    sleep 1
    docker exec clab-ot-anom-modbus-master python3 /opt/modbus/master.py modbus-server --duration {{secs}}
    sleep 1
    docker exec clab-ot-anom-modbus-server sh -c 'kill $(pidof tcpdump) 2>/dev/null || true'
    sleep 1
    mkdir -p data
    docker cp clab-ot-anom-modbus-server:/tmp/capture.pcap data/capture-$ts.pcap
    echo "captured lab/data/capture-$ts.pcap — inspect on the host: tshark -r lab/data/capture-$ts.pcap -Y mbtcp"

# tear the lab down
down:
    clab des -t clab-ot-anom.clab.yml -c

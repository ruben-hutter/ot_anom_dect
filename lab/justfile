# ot-anom lab — hello-world Modbus TCP in containerlab.
# Run from this directory. `just` alone lists recipes.

# deploy 2 containers (modbus-server + modbus-master) and start the slave.
# First run installs python3-pymodbus inside them (~1 min, needs internet).
up:
    clab dep -t clab-ot-anom.clab.yml
    docker exec clab-ot-anom-modbus-server sh -c 'apt-get update -qq && apt-get install -y -qq python3-pymodbus >/dev/null'
    docker exec clab-ot-anom-modbus-master sh -c 'apt-get update -qq && apt-get install -y -qq python3-pymodbus >/dev/null'
    docker exec -d clab-ot-anom-modbus-server sh -c 'python3 /opt/modbus/server.py >/tmp/modbus-server.log 2>&1'
    @echo "lab is up. try: just hello"

# hello world: the master writes two holding registers across the network
# (FC6), polls them back (FC3) and reads the slave's read-only input
# registers (FC4) — then the server log shows the same exchange from the
# slave side, register state included.
hello:
    docker exec clab-ot-anom-modbus-master python3 /opt/modbus/master.py modbus-server
    @echo "--- modbus-server saw: ---"
    docker exec clab-ot-anom-modbus-server sh -c 'grep -E "slave up|seeded|applied|served" /tmp/modbus-server.log'

# tear the lab down
down:
    clab des -t clab-ot-anom.clab.yml -c
